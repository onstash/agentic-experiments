{
  "name": "pi-checklist",
  "version": "0.2.0",
  "private": true,
  "description": "Session-scoped checklist extension for Pi",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^1.0.4",
    "typebox": "^1.3.36"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=20"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
