{
  "name": "pi-checklist",
  "version": "0.1.0",
  "private": true,
  "description": "Session-scoped checklist extension for Pi",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "pnpm format:check && pnpm lint && pnpm build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=20"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
