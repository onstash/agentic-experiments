{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "total-recall",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-28",
  "vars": {
    "LIFE_OS_BASE_URL": "https://life-os-web.hastons.workers.dev",
  },
  "services": [
    {
      "binding": "LIFE_OS",
      "service": "life-os-web",
    },
  ],
}
